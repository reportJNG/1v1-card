--!strict
-- POLISH_MISSION A: the client's UI state machine (Shared/Ui/UiFlow).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UiFlow = require(ReplicatedStorage:WaitForChild("Shared").Ui.UiFlow)

local function playing()
	local f = UiFlow.new()
	UiFlow.send(f, "loaded")
	UiFlow.send(f, "play")
	return f
end

return function()
	describe("UI flow", function()
		it("goes Loading -> MainMenu -> Playing, and back to the menu", function()
			local f = UiFlow.new()
			expect(UiFlow.state(f)).to.equal("Loading")
			expect(UiFlow.send(f, "play")).to.equal(false) -- not before the menu
			expect(UiFlow.send(f, "loaded")).to.equal(true)
			expect(UiFlow.state(f)).to.equal("MainMenu")
			expect(UiFlow.send(f, "play")).to.equal(true)
			expect(UiFlow.state(f)).to.equal("Playing")
			expect(UiFlow.send(f, "menu")).to.equal(true)
			expect(UiFlow.state(f)).to.equal("MainMenu")
		end)

		it("leaves to the main menu from anywhere but loading, with nothing left open", function()
			local f = UiFlow.new()
			expect(UiFlow.send(f, "leave")).to.equal(false) -- never from the loading screen
			UiFlow.send(f, "loaded")
			UiFlow.send(f, "play")
			UiFlow.send(f, "open", "Shop")
			expect(UiFlow.send(f, "leave")).to.equal(true)
			expect(UiFlow.state(f)).to.equal("MainMenu")
			expect(f.panel).to.equal(nil)
			UiFlow.send(f, "play")
			UiFlow.send(f, "battleStart")
			expect(UiFlow.send(f, "leave")).to.equal(true) -- the server forfeits the battle
			expect(UiFlow.state(f)).to.equal("MainMenu")
			UiFlow.send(f, "play")
			UiFlow.send(f, "queueJoin")
			UiFlow.send(f, "leave")
			expect(UiFlow.state(f)).to.equal("MainMenu")
		end)

		it("keeps one modal panel at a time; opening another replaces it", function()
			local f = playing()
			UiFlow.send(f, "open", "Shop")
			expect(UiFlow.state(f)).to.equal("Panel")
			expect(f.panel).to.equal("Shop")
			UiFlow.send(f, "open", "Deck")
			expect(f.panel).to.equal("Deck")
			expect(UiFlow.send(f, "back")).to.equal(true)
			expect(UiFlow.state(f)).to.equal("Playing")
			expect(f.panel).to.equal(nil)
			expect(UiFlow.send(f, "back")).to.equal(false) -- nothing left to close
		end)

		it("ignores repeated events, so a double click can't open things twice", function()
			local f = playing()
			expect(UiFlow.send(f, "open", "Shop")).to.equal(true)
			expect(UiFlow.send(f, "open", "Shop")).to.equal(false)
			expect(UiFlow.send(f, "close")).to.equal(true)
			expect(UiFlow.send(f, "close")).to.equal(false)
		end)

		it("shows the main menu alone, then only the currencies under modals", function()
			local f = UiFlow.new()
			UiFlow.send(f, "loaded")
			local menu = UiFlow.view(f)
			expect(menu.hud).to.equal("hidden")
			expect(menu.inputLocked).to.equal(true)
			expect(menu.blur).to.equal(false)
			expect(menu.menuShot).to.equal(true)
			UiFlow.send(f, "play")
			local free = UiFlow.view(f)
			expect(free.hud).to.equal("full")
			expect(free.inputLocked).to.equal(false)
			expect(free.blur).to.equal(false)
			expect(free.menuShot).to.equal(false)
			UiFlow.send(f, "open", "Inventory")
			local modal = UiFlow.view(f)
			expect(modal.hud).to.equal("currencies")
			expect(modal.inputLocked).to.equal(true)
			expect(modal.blur).to.equal(true)
		end)

		it("returns to the game, not a closed panel, when the panel under a hatch was closed", function()
			local f = playing()
			UiFlow.send(f, "open", "Shop")
			UiFlow.send(f, "hatchStart")
			UiFlow.send(f, "close") -- the shop under the hatch closes
			expect(UiFlow.state(f)).to.equal("Hatching")
			UiFlow.send(f, "hatchEnd")
			expect(UiFlow.state(f)).to.equal("Playing")
			expect(f.panel).to.equal(nil)
			expect(UiFlow.view(f).blur).to.equal(false)
		end)

		it("hides the hub HUD completely during hatching, battles and results", function()
			local f = playing()
			UiFlow.send(f, "open", "Shop")
			UiFlow.send(f, "hatchStart")
			expect(UiFlow.view(f).hud).to.equal("hidden")
			UiFlow.send(f, "hatchEnd")
			expect(UiFlow.state(f)).to.equal("Panel") -- back to the shop it was opened from
			expect(f.panel).to.equal("Shop")
			UiFlow.send(f, "battleStart")
			expect(UiFlow.view(f).hud).to.equal("hidden")
			expect(f.panel).to.equal(nil) -- a battle closes the panel under it
			UiFlow.send(f, "open", "Deck")
			expect(UiFlow.state(f)).to.equal("Battle") -- no panels over a battle
			UiFlow.send(f, "battleEnd")
			expect(UiFlow.state(f)).to.equal("Result")
			expect(UiFlow.view(f).hud).to.equal("hidden")
			UiFlow.send(f, "resultDone")
			expect(UiFlow.state(f)).to.equal("Playing")
		end)

		it("tracks the ranked queue as its own state, which a battle ends", function()
			local f = playing()
			UiFlow.send(f, "queueJoin")
			expect(UiFlow.state(f)).to.equal("Queue")
			expect(UiFlow.view(f).hud).to.equal("full")
			UiFlow.send(f, "battleStart")
			UiFlow.send(f, "battleEnd")
			UiFlow.send(f, "resultDone")
			expect(UiFlow.state(f)).to.equal("Playing")
			UiFlow.send(f, "queueJoin")
			UiFlow.send(f, "queueLeave")
			expect(UiFlow.state(f)).to.equal("Playing")
		end)

		it("can't leave for the menu in the middle of a battle or a hatch", function()
			local f = playing()
			UiFlow.send(f, "battleStart")
			expect(UiFlow.send(f, "menu")).to.equal(false)
			UiFlow.send(f, "battleEnd")
			UiFlow.send(f, "resultDone")
			UiFlow.send(f, "hatchStart")
			expect(UiFlow.send(f, "menu")).to.equal(false)
			expect(UiFlow.send(f, "back")).to.equal(false) -- a hatch finishes (or is skipped) itself
		end)
	end)
end
