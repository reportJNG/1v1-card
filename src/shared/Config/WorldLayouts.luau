--!strict
-- What each world contains, as data: its look (terrain, props, ambience), its farming resources
-- and its NPCs. The world builder (Server/World/WorldBuilder) and the farming rules
-- (Shared/Domain/Farming) both read positions from Shared/Domain/WorldLayout, so the server's
-- range check always matches what was built. Every world is self-contained: building one world
-- needs only its entry here, its props (Config/WorldProps) and its lighting (Config/Lighting
-- world<n>), so a world can later move into its own place. The art is a first pass from generated
-- meshes and terrain (ContentStatus: worldArt).

export type Resource = {
	itemId: string,
	nodes: number, -- how many nodes of this resource the world has
	respawnSeconds: number, -- per player: a harvested node is ready again after this
	yield: { number }, -- { min, max } items per harvest
	rareItemId: string?, -- optional rare drop from this node
	rareChance: number?,
	model: string, -- Config/WorldProps key the node is drawn with
}

-- Terrain is generated by the builder from this (Terrain is one object per place, so it can't
-- live in the world's model). The farm field is flat at y = 0 so the node positions stay exact.
export type TerrainSpec = {
	ground: string, -- Enum.Material name of the field
	path: string, -- the path from the spawn to the field
	hills: string, -- the ring of hills around the edge
	colors: { [string]: string }, -- Terrain:SetMaterialColor; one colour per material across all worlds
	centre: { material: string, radius: number }?, -- a pond, lake or lava pool in the field
	island: boolean?, -- a floating island over the void instead of a ground slab
	floating: number?, -- floating rocks in the sky
	hillHeight: number, -- peak height of the edge hills
}

export type Decor = {
	model: string, -- Config/WorldProps key
	count: number,
	scale: { number }, -- { min, max }
	zone: "edge" | "field", -- edge: the outer ring; field: between the node rings
}

export type Ambience = {
	texture: string, -- Config/UiAssets slot
	colors: { string },
	rate: number, -- particles per second (ART_STYLE budget: <= 20)
	direction: "fall" | "rise" | "drift",
	size: number,
}

-- The landmark at the spawn (MASTER_FIX_PLAN Phase 12): a paved plaza, a welcome arch over the
-- path into the field in the world's stone and accent, and two big copies of the world's signature
-- mesh flanking it.
export type Gate = {
	landmark: string, -- Config/WorldProps key
	scale: number,
	stone: string, -- the arch and plaza colour
	material: string, -- Enum.Material name
	ring: string?, -- node rings and gate trim on light ground (default: white, the accent)
}

export type Theme = {
	ground: string, -- UI colour of the world (picker fallback)
	accent: string,
	terrain: TerrainSpec,
	decor: { Decor },
	ambience: Ambience,
	gate: Gate?,
}

export type Layout = {
	world: number,
	theme: Theme,
	resources: { Resource },
	merchantName: string,
}

local function layout(
	world: number,
	theme: Theme,
	common: { { string } }, -- { itemId, model } x2
	rare: { string }, -- { itemId, model }
	respawn: number,
	merchantName: string
): Layout
	return {
		world = world,
		theme = theme,
		resources = {
			{
				itemId = common[1][1],
				model = common[1][2],
				nodes = 6,
				respawnSeconds = respawn,
				yield = { 1, 3 },
				rareItemId = rare[1],
				rareChance = 0.03,
			},
			{
				itemId = common[2][1],
				model = common[2][2],
				nodes = 5,
				respawnSeconds = respawn + 10,
				yield = { 1, 2 },
				rareItemId = rare[1],
				rareChance = 0.03,
			},
			{ itemId = rare[1], model = rare[2], nodes = 2, respawnSeconds = 120, yield = { 1, 1 } },
		},
		merchantName = merchantName,
	}
end

local function decor(model: string, count: number, lo: number, hi: number, zone: "edge" | "field"): Decor
	return { model = model, count = count, scale = { lo, hi }, zone = zone }
end

